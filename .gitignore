# 根目录只纳入源码、验证、构建和发布所需内容
/*
!/.github/
!/.gitignore
!/.gitattributes
!/src/
!/tests/
!/assets/
!/broadcasts/
!/updates/
!/README.md
!/LICENSE
!/THIRD-PARTY-NOTICES.md
!/*.ps1

# 文档、设计记录和重复素材仅保留在本地
/docs/
/CHANGELOG.md
/promo-video/
/relay/
/assets/*
!/assets/app.ico
!/assets/app.png
!/assets/branding/
/assets/branding/*
!/assets/branding/make_icon.py
!/assets/branding/scp-source.svg
/broadcasts/*
!/broadcasts/templates.json

# 本地诊断工具和调试样例
/build-diagnostic.ps1
/diagnose-crosshair.ps1
/diagnose-session.ps1
/src/diagnostics/
/tests/DiagnoseCrosshair.ps1
/tests/fullscreen-probe/
/tests/FullscreenDiscovery.cs
/tests/FullscreenDiscovery.ps1
/tests/FullscreenTarget.cpp

# 编译、发布产物与本机分析文件
# updates/ 是供 Gitee 自动镜像同步的正式更新载荷，须随源码提交
/build/
/dist/
**/bin/
**/obj/
/artifacts/
/output/
/tmp/
/temp/

# 编辑器、用户设置和临时文件
/.vs/
/.idea/
/.vscode/
/.codex/
*.user
*.suo
*.userosscache
*.sln.docstates
*.log
*.tmp
*.bak
*.swp
*.swo
*~
Thumbs.db
Desktop.ini
.DS_Store

# Python 资源制作缓存与虚拟环境
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# 本地凭据和环境配置，保留可公开的示例
.env
.env.*
!.env.example
!.env.sample

# Private endpoint authoring input
/.private/
